{
  "$schema": "https://opencode.ai/config.json",
  "project": {
    "name": "Animal Tracking System",
    "stack": ["Laravel API", "React Web", "Flutter Mobile"]
  },
  "subagents": {
    "*": true
  },
  "agents": {
    "lead": {
      "role": "Plan feature and define API",
      "input": ["feature"],
      "output": ["api_spec"],
      "mode": "subagent"
    },
    "backend": {
      "role": "Build Laravel API",
      "input": ["api_spec"],
      "output": ["endpoints"],
      "mode": "subagent"
    },
    "web": {
      "role": "Build React UI",
      "input": ["api_spec"],
      "output": ["pages"],
      "mode": "subagent"
    },
    "mobile": {
      "role": "Build Flutter app",
      "input": ["api_spec"],
      "output": ["screens"],
      "mode": "subagent"
    },
    "qa": {
      "role": "Test everything",
      "input": ["endpoints", "pages", "screens"],
      "output": ["issues"],
      "mode": "subagent"
    },
    "brain": {
      "instructions": "Break feature into backend, frontend, and mobile tasks.",
      "role": "Plan feature breakdown",
      "input": ["feature"],
      "output": ["task_breakdown"],
      "mode": "subagent"
    },
    "developer": {
      "instructions": "Implement Laravel APIs, React UI, and Flutter screens.",
      "role": "Implement features",
      "input": ["task_breakdown"],
      "output": ["implementation"],
      "mode": "subagent"
    },
    "tester": {
      "instructions": "Test API, UI, and mobile. Report issues clearly.",
      "role": "Test and validate",
      "input": ["implementation"],
      "output": ["test_report"],
      "mode": "subagent"
    }
  },
  "workflow": ["lead", "brain", "backend", "web", "mobile", "developer", "tester", "qa"]
}
