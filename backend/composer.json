{
    "name": "oasis/trace",
    "type": "project",
    "description": "The Oasis - Livestock Tracking Platform",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "guzzlehttp/guzzle": "*",
        "laravel/framework": "^11.0",
        "laravel/horizon": "^5.47",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.9",
        "nunomaduro/collision": "^8.5",
        "php-mqtt/laravel-client": "^1.8",
        "predis/predis": "^3.4",
        "sentry/sentry-laravel": "^4.25",
        "spatie/flare-client-php": "^2.10",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-translatable": "6.7",
        "stripe/stripe-php": "^20.0",
        "symfony/clock": "^7.0 || ^6.0",
        "symfony/css-selector": "^7.0 || ^6.0",
        "symfony/event-dispatcher": "^7.0 || ^6.0",
        "symfony/string": "^7.0 || ^6.0",
        "symfony/translation": "^7.0 || ^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.30"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
