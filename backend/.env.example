APP_NAME="The Oasis - Staging"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8050
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATION_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=Your database host (from your DB provider)
DB_PORT=3306
DB_DATABASE=Your database name
DB_USERNAME=Your database username
DB_PASSWORD=Your database password

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=your-app-name.up.railway.app

# MySQL Configuration (for when Docker is available)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=oasis_staging
# DB_USERNAME=oasis_user
# DB_PASSWORD=oasis_password

# Twilio SMS/Call Configuration
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
SMS_FROM_NUMBER=+1234567890
SMS_ENABLED=false
CALL_ENABLED=false

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@oasis.com
MAIL_FROM_NAME="Oasis Trace"

# Redis Configuration (for when Redis is available)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379;

# Pusher Configuration (for real-time features)
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https;
# PUSHER_APP_CLUSTER=mt1;

# Stripe Configuration (for payments)
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
